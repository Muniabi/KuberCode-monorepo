{
    "version": 1,
    "hooks": {
        "afterFileEdit": [
            {
                "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/log-after-edit.ps1"
            }
        ],
        "beforeShellExecution": [
            {
                "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/log-shell.ps1"
            }
        ]
    }
}
