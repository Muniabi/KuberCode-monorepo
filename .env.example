# =============================================================================
# KuberCode — единый .env для docker compose (корень монорепо)
# Скопируйте:  cp .env.example .env
# Имена переменных совпадают с .env.example внутри каждого сервиса.
# =============================================================================

# ---- Домен для Caddy (proxy на порту 80) ----
# Поддомены: app.$DOMAIN, admin.$DOMAIN, api.$DOMAIN
# Пример продакшена: DOMAIN=kubercode.mikata.ru
DOMAIN=localhost

# ---- Публичные URL (браузер / CORS). Без портов при работе через proxy. ----
# Примеры:
#   proxy + localhost:  http://localhost  / http://app.localhost / …
#   по IP + profile exposed: http://203.0.113.10:3001 …
#   домен:              http://kubercode.mikata.ru (см. блок ниже)
#
# ВАЖНО: NEXT_PUBLIC_* вшиваются в Next.js на этапе build.
# После смены URL: docker compose up -d --build

# --- localhost через proxy (:80), app.localhost резолвится в браузерах ---
NEXT_PUBLIC_API_URL=http://api.localhost
NEXT_PUBLIC_MARKETING_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://app.localhost
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost
CORS_ORIGINS=http://localhost,http://app.localhost,http://admin.localhost

# --- Пример: kubercode.mikata.ru (раскомментируйте и закомментируйте блок выше) ---
# DOMAIN=kubercode.mikata.ru
# NEXT_PUBLIC_API_URL=http://api.kubercode.mikata.ru
# NEXT_PUBLIC_MARKETING_URL=http://kubercode.mikata.ru
# NEXT_PUBLIC_APP_URL=http://app.kubercode.mikata.ru
# NEXT_PUBLIC_ADMIN_URL=http://admin.kubercode.mikata.ru
# CORS_ORIGINS=http://kubercode.mikata.ru,http://app.kubercode.mikata.ru,http://admin.kubercode.mikata.ru

# SSR marketing → API внутри docker-сети (браузер сюда не ходит)
INTERNAL_API_URL=http://api:4000

# ---- Порты на хосте ----
PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
# Прямые порты приложений — только с: docker compose --profile exposed up -d
API_HOST_PORT=4000
MARKETING_HOST_PORT=3001
APP_HOST_PORT=3002
ADMIN_HOST_PORT=3003
MONGO_HOST_PORT=27018
JUDGE0_HOST_PORT=2358

# ---- API / инфраструктура (внутри сети compose) ----
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=kubercode
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
ACCESS_TTL=1h
REFRESH_TTL=168h
COOKIE_SECURE=false

RUNNER_WORKERS=2
SEED_ON_BOOT=true
SEED_ADMIN_PASSWORD=admin123456

# Judge0 (опционально). Пустой JUDGE0_URL = локальный runner в api.
# После: docker compose --profile judge0 up -d
# JUDGE0_URL=http://judge0-server:2358
JUDGE0_URL=
JUDGE0_TOKEN=
JUDGE0_DB_PASSWORD=judge0_dev_password
